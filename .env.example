# Copie para .env e preencha. O .env NUNCA deve ir para o controle de versão.

# --- LLM (agentes 02–05, 10) — preencha o provedor que for usar
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Google Ads API (agente 01)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Conta a consultar, se diferente da conta de login (MCC)
GOOGLE_ADS_CUSTOMER_ID=

# --- Google Search Console e Analytics 4 (agente 08)
GOOGLE_APPLICATION_CREDENTIALS=C:/caminho/para/service-account.json
GSC_SITE_URL=sc-domain:seu-dominio.com.br
GA4_PROPERTY_ID=

# --- Publicação (agente 07) — modo real ainda DESABILITADO no código (ver
# agents/07_publisher/prompt.md); estas variáveis só serão usadas quando for ligado.
# WordPress REST API, com Application Password:
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=
# Ghost Admin API, com uma chave no formato "id:secret":
GHOST_ADMIN_API_URL=
GHOST_ADMIN_API_KEY=

# --- Banco de imagens (agente 15) — pelo menos uma das duas, contas grátis:
# pexels.com/api (aprovação instantânea) e/ou pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=
